DATABASE_URL=postgres://anchorpoint:anchorpoint@localhost:5433/anchorpoint
API_BASE_URL=http://localhost:4000
API_PORT=4000
API_HOST=127.0.0.1
INTERNAL_API_TOKEN=replace-with-a-long-random-value
APP_AUTH_SECRET=replace-with-a-different-long-random-value
DEMO_USER_EMAIL=revops@anchorpoint.example
DEMO_USER_PASSWORD=replace-with-a-demo-password
WORKER_ID=anchorpoint-worker-local

# Attio read-only connector (Milestone 3, decision 0011). Create a workspace access
# token with read-only scopes only. Never commit real values.
# ATTIO_ACCESS_TOKEN=
# ATTIO_CONNECTION_ID=anchorpoint-attio
# ATTIO_SITE_OBJECT=sites
# ATTIO_CALL_OBJECT=call_logs  (Attio reserves the "calls" slug)
# Enrichment writeback (docs/milestones/attio-writeback-notes.md). A separate token
# scoped to record read-write; it must differ from ATTIO_ACCESS_TOKEN.
# ATTIO_WRITEBACK_TOKEN=

# Lemlist connector (Milestone 6, decision 0012). Real API, launch switched off: no
# mailbox is connected and LEMLIST_LAUNCH_ENABLED is never set in this project.
# Create the key in Lemlist under Settings > Integrations. Never commit real values.
# LEMLIST_API_KEY=
# LEMLIST_CAMPAIGN_ID=            # default campaign; lemlist:enroll --campaign overrides it
# LEMLIST_WEBHOOK_SECRET=         # shared secret Lemlist echoes in each webhook body

# Superseded Salesforce read-only connector (decision 0005, replaced by 0011). Leave unset until the Developer
# Edition org and its read-only integration user exist. Never commit real values.
# SALESFORCE_AUTH_FLOW=client_credentials
# SALESFORCE_LOGIN_URL=https://your-domain.develop.my.salesforce.com
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=
# SALESFORCE_USERNAME=              # jwt_bearer only
# SALESFORCE_JWT_PRIVATE_KEY_PATH=  # jwt_bearer only; keep the key outside the repository
# SALESFORCE_CONNECTION_ID=anchorpoint-dev
# SALESFORCE_API_VERSION=v62.0
# SALESFORCE_SITE_OBJECT=Site__c
# SALESFORCE_INITIAL_SINCE=2024-01-01T00:00:00Z
# Comma-separated name=slug pairs when Attio gave a recreated attribute a suffixed slug.
ATTIO_WRITEBACK_SLUGS=

# Claude API key for lemlist:draft (signal-based outreach drafts, reviewed by a human
# before lemlist:enroll carries them as variables; nothing is ever sent).
# ANTHROPIC_API_KEY=
