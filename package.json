{
  "name": "portco-launch-control",
  "private": true,
  "type": "module",
  "scripts": {
    "api": "node apps/api/src/server.ts",
    "dev": "next dev apps/web --hostname 127.0.0.1",
    "build": "next build apps/web",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "node scripts/run-migrations.ts",
    "foundation:load": "node scripts/load-foundation-fixture.ts",
    "foundation:setup": "npm run db:migrate && npm run foundation:load && npm run worker:once",
    "foundation:verify": "node scripts/verify-foundation.ts",
    "foundation:verify-failure": "node scripts/verify-failed-job.ts",
    "start": "next start apps/web",
    "inspect": "node scripts/run-inspection.ts",
    "sample:georgia": "node scripts/georgia-sample/resolve-operators.ts && node scripts/georgia-sample/serviceability.ts && node scripts/georgia-sample/signals.ts && node scripts/georgia-sample/serper-lookups.ts && node scripts/georgia-sample/tier.ts",
    "sample:georgia:pull": "node scripts/georgia-sample/pull-cms.ts",
    "sample:georgia:clay-export": "node scripts/georgia-sample/clay-export.ts",
    "sample:georgia:clay-reduce": "node scripts/georgia-sample/clay-reduce.ts",
    "qa:visual": "node scripts/visual-qa.ts",
    "qa:visual:failed-job": "node scripts/visual-qa.ts --expect-failed-job",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit --project apps/web/tsconfig.json",
    "worker": "node apps/worker/src/worker.ts",
    "worker:once": "node apps/worker/src/worker.ts --once"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  }
}
